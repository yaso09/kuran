<?xml version='1.0' encoding='utf-8'?>
<widget id="com.yasireymen.kuran" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Kur'an-ı Kerim</name>
    <description>
        Kur'an-ı Kerîm Okuma Uygulaması
    </description>
    <author email="" href="https://github.com/yaso09">Yasir Eymen Kayabaşı</author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- Uygulama İçi Network Erişimi (GitHub API, namaz vakitleri vb.) -->
    <access origin="*" />
    <allow-navigation href="*" />

    <!-- İkonlar -->
    <icon src="www/muslim-icon_quran.png" platform="android" width="192" height="192" />
    <icon src="www/muslim-icon_quran.png" platform="android" width="512" height="512" />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="180" height="180" />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="57"  height="57"  />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="72"  height="72"  />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="76"  height="76"  />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="114" height="114" />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="120" height="120" />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="144" height="144" />
    <icon src="www/muslim-icon_quran.png" platform="ios" width="152" height="152" />

    <!-- Splash Screen'ler -->
    <splash src="www/muslim-icon_quran.png" platform="ios" width="640"  height="1136" />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="1136" height="640"  />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="1334" height="750"  />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="750"  height="1334" />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="2208" height="1242" />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="1242" height="2208" />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="1024" height="768"  />
    <splash src="www/muslim-icon_quran.png" platform="ios" width="768"  height="1024" />

    <!-- ================================================ -->
    <!--  EKLENTILER                                       -->
    <!-- ================================================ -->

    <!-- Dosya Sistemi -->
    <plugin name="cordova-plugin-file"            spec="^7.0.0" />

    <!-- ZIP Açma (kiraat/tefsir yüklemek için) -->
    <plugin name="cordova-plugin-zip"             spec="^3.1.0" />

    <!-- Konum (namaz vakitleri) -->
    <plugin name="cordova-plugin-geolocation"     spec="^5.0.0" />

    <!-- Runtime İzin İsteme — mobileFileManager.js'de cordova.plugins.permissions ile kullanılır -->
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />

    <!-- Cihaz Bilgisi (Android sürümünü okumak için — Android 13+ izin ayrımı) -->
    <plugin name="cordova-plugin-device"          spec="^2.1.0" />

    <!-- ================================================ -->
    <!--  ANDROID MANİFEST İZİNLERİ                       -->
    <!-- ================================================ -->
    <config-file target="AndroidManifest.xml" parent="/*" xmlns:android="http://schemas.android.com/apk/res/android">

        <!-- Konum -->
        <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
        <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

        <!-- READ/WRITE_EXTERNAL_STORAGE KALDIRILDI -->
        <!-- cordova-plugin-geolocation bunları zaten ekliyor, tekrar yazınca çakışıyor -->

        <!-- Depolama — Android 13+ (API 33+) -->
        <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
        <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"  />
        <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"  />

        <!-- İnternet -->
        <uses-permission android:name="android.permission.INTERNET" />

    </config-file>

    <!-- Android 9 ve altı için eski harici depolama uyumluluğu -->
    <edit-config target="AndroidManifest.xml" parent="/manifest/application" mode="merge">
        <application android:requestLegacyExternalStorage="true" />
    </edit-config>

    <!-- ================================================ -->
    <!--  DOSYA KONUMLARI                                  -->
    <!-- ================================================ -->
    <preference name="AndroidPersistentFileLocation" value="Internal" />
    <preference name="iosPersistentFileLocation"     value="Library"  />

    <!-- ================================================ -->
    <!--  GENEL TERCİHLER                                  -->
    <!-- ================================================ -->
    <preference name="DisallowOverscroll"          value="true"  />
    <preference name="android-minSdkVersion"       value="22"    />
    <preference name="android-targetSdkVersion"    value="34"    />
    <preference name="BackupWebStorage"            value="none"  />
    <preference name="SplashScreenDelay"           value="2000"  />
    <preference name="FadeSplashScreenDuration"    value="500"   />
    <preference name="ShowSplashScreenSpinner"     value="false" />
    <preference name="android-compileSdkVersion" value="36" />

</widget>